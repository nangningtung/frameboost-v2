<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Slim edge handle. Tap or swipe inward to open panel. -->
    <FrameLayout
        android:id="@+id/view_bubble"
        android:layout_width="40dp"
        android:layout_height="32dp"
        android:layout_gravity="center_vertical|end"
        android:background="@drawable/bg_edge_handle"
        android:clickable="true"
        android:focusable="false">

        <TextView
            android:id="@+id/txt_bubble_fps"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="--"
            android:textColor="#D0BCFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:id="@+id/dot_state"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dot" />
    </FrameLayout>

    <!-- ============================================================== -->
    <!-- EDGE SIDE PANEL (opened by tapping / swiping the bubble)        -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/view_sidepanel"
        android:layout_width="288dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/panel_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_panel_state"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="FrameBoost"
                    android:textColor="#E5E1E6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_panel_game"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="No game"
                    android:textColor="#C9C5CA"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_close_panel"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_button"
                android:gravity="center"
                android:text="✕"
                android:textColor="#C9C5CA"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="#1F46464F" />

        <!-- Live metrics: one hero value, then compact telemetry grid. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_track"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="FRAME RATE"
                android:textColor="#8A868E"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_m_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="-- FPS"
                android:textColor="#D0BCFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPU"
                    android:textColor="#8A868E"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/txt_m_gpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="N/A"
                    android:textColor="#E5E1E6"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPU BIG"
                    android:textColor="#8A868E"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/txt_m_cpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="N/A"
                    android:textColor="#E5E1E6"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NETWORK"
                    android:textColor="#8A868E"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/txt_m_net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="N/A"
                    android:textColor="#7DDCA5"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATTERY"
                    android:textColor="#8A868E"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/txt_m_bat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="N/A"
                    android:textColor="#E5E1E6"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#1F46464F" />

        <!-- HUD mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.06"
            android:text="BUBBLE MODE"
            android:textColor="#C9C5CA"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/btn_type_compact"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_active"
                android:fontFamily="monospace"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="FPS"
                android:textAllCaps="false"
                android:textColor="#E8DEF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_type_detail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+ TEMP"
                android:textAllCaps="false"
                android:textColor="#C9C5CA"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btn_type_full"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+ GPU"
                android:textAllCaps="false"
                android:textColor="#C9C5CA"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Preset -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.06"
            android:text="GAME PRESET"
            android:textColor="#C9C5CA"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/btn_preset_battery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="BAT"
                android:textAllCaps="false"
                android:textColor="#C9C5CA"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btn_preset_balanced"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="BAL"
                android:textAllCaps="false"
                android:textColor="#C9C5CA"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btn_preset_perf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="PERF"
                android:textAllCaps="false"
                android:textColor="#C9C5CA"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btn_preset_esports"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="ESP"
                android:textAllCaps="false"
                android:textColor="#C9C5CA"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- FPS overlay toggle -->
        <LinearLayout
            android:id="@+id/btn_fps_overlay"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_segment_track"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FPS overlay"
                android:textColor="#E5E1E6"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txt_telemetry_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="ON"
                android:textColor="#D0BCFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Tap bubble to open · swipe to close"
            android:textColor="#8A868E"
            android:textSize="8sp" />
    </LinearLayout>
</FrameLayout>
