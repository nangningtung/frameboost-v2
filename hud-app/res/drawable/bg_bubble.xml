<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft accent halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1FD0BCFF" />
        </shape>
    </item>
    <!-- Bubble surface -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#151419"
                android:startColor="#2B2833" />
            <stroke
                android:width="1dp"
                android:color="#59D0BCFF" />
        </shape>
    </item>
</layer-list>
